cpp_sources	= *.c services\*.c

.BEFORE:
	@cd $(SRC_PATH)

.AFTER:
	@if exist *.obj @del /f /q *.obj
	@if exist *.lnk @del /f /q *.lnk
	@if exist *.err @del /f /q *.err
	@cd ..\..
	@echo Success!

all: compile

compile: .SYMBOLIC
	@echo Compiling SYSTEM library...
	@$(COMPILER_CMD) $(cpp_sources)
